@model IEnumerable<Invoice>

@{
    ViewData["Title"] = "Index";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.InvoiceNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateOfIssue)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.InvoiceNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateOfIssue)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.InvoiceNumber }) |
                    @Html.ActionLink("Details", "Details", new { id = item.InvoiceNumber }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.InvoiceNumber })
                </td>
            </tr>
        }
    </tbody>
</table>
